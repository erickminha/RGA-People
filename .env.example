# ============================================================
# Supabase (obrigatório)
# Painel: Supabase Dashboard -> Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service Role: necessária para ações de servidor privilegiadas
# (convites de colaboradores, signOut forçado). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# URL pública onde o portal está publicado (usada em links de convite/e-mail)
NEXT_PUBLIC_SITE_URL=https://app.rgapeople.com.br

# ============================================================
# Resend (obrigatório para envio de e-mails: convites, notificações)
# Painel: https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=sua_resend_api_key_aqui
RESEND_FROM_EMAIL="RGA People <no-reply@seudominio.com>"

# ============================================================
# Cloudflare Turnstile (obrigatório para o captcha em telas públicas,
# ex.: login e aceite de convite)
# Painel: https://dash.cloudflare.com -> Turnstile
# ⚠️ Gere um par de chaves NOVO para o seu projeto — nunca reutilize
# chaves de exemplo ou de outro projeto.
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua_turnstile_site_key_aqui
CLOUDFLARE_TURNSTILE_SECRET_KEY=sua_turnstile_secret_key_aqui
